{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clover Launcher",
  "identifier": "fr.clovergames.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clover Launcher",
        "width": 1100,
        "height": 680,
        "resizable": true,
        "center": true,
        "minWidth": 1000,
        "minHeight": 640,
        "label": "main",
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "languages": ["French"],
        "startMenuFolder": "Clover Games"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMkRFNDUzRkQyNDU1MkQKUldRdFZTVDlVK1F0ay9rVFhORTRiWnVpL2lCVFJlOTZOUW05MzZ6azB2OUhsc1JhTGYyZk9KVGoK",
      "endpoints": [
        "https://cdn.clovergames.fr/launcher/prod/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
